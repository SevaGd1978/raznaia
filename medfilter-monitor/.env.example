# Скопируйте в .env и заполните секреты

# Telegram-уведомления (рекомендуется)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Опционально: DaMIA API-Закупки (поиск активных извещений)
# Регистрация: https://damia.ru/apizakupki
DAMIA_API_KEY=

# Провайдеры через запятую: clearspending,zakupki_html,damia
MONITOR_PROVIDERS=clearspending,zakupki_html,damia

# Интервал демона (сек)
MONITOR_INTERVAL_SEC=3600

# Путь к SQLite
MONITOR_DB=data/procurements.db

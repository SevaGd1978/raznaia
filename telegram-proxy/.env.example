# Порт на сервере (внутри контейнера всегда 443)
PROXY_PORT=443

# 32 hex-символа (16 байт). Префикс dd — случайный padding (рекомендуется).
# Генерация: head -c 16 /dev/urandom | xxd -ps | sed 's/^/dd/'
MTPROTO_SECRET=dd000102030405060708090a0b0c0d0e0f

# Публичный IP или домен сервера (для ссылок подключения)
SERVER_HOST=your-server-ip-or-domain

# Опционально: тег для регистрации в @MTProxybot
# MTPROTO_TAG=

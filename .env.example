# Public IP of your VPS (auto-filled by setup.sh)
VPS_IP=203.0.113.10

# Listen port — 443 is best (looks like HTTPS)
MTG_PORT=443

# Domain used for Fake-TLS camouflage (must be a real popular site)
MTG_DOMAIN=cloudflare.com

# Fake-TLS secret (ee… prefix). Generated by setup.sh — do not invent manually.
MTG_SECRET=eeREPLACE_ME
